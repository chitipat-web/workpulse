default_platform(:ios)

TEAM_ID = "YU352X7M2K"
APP_ID = "io.github.chitipatweb.lalamap"

platform :ios do
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: File.expand_path("~/private_keys/AuthKey_#{ENV['ASC_KEY_ID']}.p8")
    )

    # เลขบิลด์ไม่ซ้ำทุกครั้งที่รัน กัน TestFlight ปฏิเสธว่าซ้ำ
    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || "1",
      xcodeproj: "App.xcodeproj"
    )

    # บอก Xcode ให้เซ็นแบบอัตโนมัติด้วยทีมนี้
    update_code_signing_settings(
      use_automatic_signing: true,
      team_id: TEAM_ID,
      path: "App.xcodeproj"
    )

    # -allowProvisioningUpdates + api_key = สร้างใบรับรอง/โพรไฟล์ + ลงทะเบียน Bundle ID อัตโนมัติ
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      api_key: api_key,
      xcargs: "-allowProvisioningUpdates",
      export_options: {
        signingStyle: "automatic",
        teamID: TEAM_ID
      }
    )

    # อัปขึ้น TestFlight — ขั้นนี้ต้องมี app record บน App Store Connect ก่อน
    # (สร้างด้วยมือครั้งเดียว เพราะ API key สร้างแอปใหม่ไม่ได้) ถ้ายังไม่มีจะเตือนแล้วข้าม
    begin
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true
      )
    rescue => e
      UI.important("ยังอัปขึ้น TestFlight ไม่ได้ (ปกติถ้ายังไม่ได้สร้าง app record): #{e.message}")
      UI.important("Build + ลงทะเบียนแอปสำเร็จแล้ว — ไปสร้าง app record บน App Store Connect แล้วรันอีกครั้ง")
    end
  end
end
