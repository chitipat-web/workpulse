require "jwt"
require "openssl"
require "net/http"
require "json"

default_platform(:ios)

TEAM_ID = "YU352X7M2K"
APP_ID = "io.github.chitipatweb.lalamap"

# สร้าง JWT สำหรับเรียก App Store Connect REST API โดยตรง
def asc_jwt
  key = OpenSSL::PKey.read(File.read(File.expand_path("~/private_keys/AuthKey_#{ENV['ASC_KEY_ID']}.p8")))
  now = Time.now.to_i
  JWT.encode(
    { iss: ENV["ASC_ISSUER_ID"], iat: now, exp: now + 1200, aud: "appstoreconnect-v1" },
    key, "ES256", { kid: ENV["ASC_KEY_ID"], typ: "JWT" }
  )
end

def asc_request(method, path, body = nil)
  uri = URI("https://api.appstoreconnect.apple.com#{path}")
  http = Net::HTTP.new(uri.host, 443)
  http.use_ssl = true
  klass = { get: Net::HTTP::Get, post: Net::HTTP::Post, delete: Net::HTTP::Delete }[method]
  req = klass.new(uri)
  req["Authorization"] = "Bearer #{asc_jwt}"
  req["Content-Type"] = "application/json"
  req.body = body.to_json if body
  res = http.request(req)
  data = (res.body && !res.body.empty?) ? JSON.parse(res.body) : {}
  [res.code.to_i, data]
end

platform :ios do
  lane :beta do
    key_path = File.expand_path("~/private_keys/AuthKey_#{ENV['ASC_KEY_ID']}.p8")

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_path
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || "1",
      xcodeproj: "App.xcodeproj"
    )

    keychain_name = "ci.keychain"
    keychain_password = "ci_temp_password"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # ===== จัดการ Apple Developer Portal ผ่าน REST API โดยตรง =====
    # ลบใบรับรอง Distribution เก่า (CI ไม่เก็บกุญแจส่วนตัว ใบเก่าใช้ไม่ได้ + กันชนเพดาน)
    _, certs = asc_request(:get, "/v1/certificates?limit=200")
    (certs["data"] || []).each do |c|
      next unless c.dig("attributes", "certificateType").to_s.include?("DISTRIBUTION")
      asc_request(:delete, "/v1/certificates/#{c['id']}")
      UI.message("ลบใบรับรองเก่า #{c['id']}")
    end

    # ลงทะเบียน Bundle ID ถ้ายังไม่มี
    _, bids = asc_request(:get, "/v1/bundleIds?filter%5Bidentifier%5D=#{APP_ID}&limit=200")
    unless (bids["data"] || []).any? { |b| b.dig("attributes", "identifier") == APP_ID }
      code, resp = asc_request(:post, "/v1/bundleIds", {
        data: { type: "bundleIds", attributes: { identifier: APP_ID, name: "LalaMap", platform: "IOS", seedId: TEAM_ID } }
      })
      UI.user_error!("ลงทะเบียน Bundle ID ไม่สำเร็จ (#{code}): #{resp}") unless [200, 201].include?(code)
      UI.success("ลงทะเบียน Bundle ID #{APP_ID} แล้ว")
    end

    # ใบรับรอง Distribution ใหม่
    cert(
      api_key: api_key,
      keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
      keychain_password: keychain_password
    )

    # โพรไฟล์แบบ App Store — ไม่ต้องมีอุปกรณ์ลงทะเบียน
    sigh(
      api_key: api_key,
      app_identifier: APP_ID
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          APP_ID => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    # อัปขึ้น TestFlight — ต้องมี app record บน App Store Connect ก่อน
    # (สร้างด้วยมือครั้งเดียว เพราะ API key สร้างแอปใหม่ไม่ได้) ถ้ายังไม่มีจะเตือนแล้วข้าม
    begin
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true
      )
    rescue => e
      UI.important("ยังอัปขึ้น TestFlight ไม่ได้ (ปกติถ้ายังไม่ได้สร้าง app record): #{e.message}")
      UI.important("Build สำเร็จแล้ว — ไปสร้าง app record บน App Store Connect แล้วรันอีกครั้ง")
    end
  end
end
